            <local-name>[amount]</local-name>
            <parent-name>[margin#csv]</parent-name>
            <remote-alias>amount</remote-alias>
            <ordinal>1</ordinal>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled="yes" />
      <column caption="Quarter" datatype="string" name="[category]" role="dimension" type="nominal" />
      <column caption="Operating margin (%)" datatype="real" name="[amount]" role="measure" type="quantitative" />
    </datasource>
    <datasource caption="deliveries" inline="true" name="textscan.deliveries" version="18.1">
      <connection class="textscan" directory="Data" filename="deliveries.csv" password="" server="">
        <relation name="deliveries#csv" table="[deliveries#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator=",">
