  <dashboards>
    <dashboard name="Executive Dashboard">
      <style />
      <size maxheight="850" maxwidth="1400" minheight="850" minwidth="1400" sizing-mode="fixed" />
      <zones>
        <zone id="1" type-v2="text" x="1000" y="1000" w="98000" h="8000">
          <formatted-text>
            <run bold="true" fontsize="20">Tesla | Quarterly financial and operational analytics</run>
          </formatted-text>
        </zone>
        <zone id="2" type-v2="text" x="1000" y="8500" w="98000" h="5000">
          <formatted-text>
            <run fontsize="11">12 reported historical quarters | 2023–2025 | SQL and Python validation passed</run>
          </formatted-text>
        </zone>
        <zone id="3" name="2025 revenue (USD million)" x="1000" y="14500" w="23750" h="14500" show-title="true">
          <zone-style>
            <format attr="border-color" value="#DCE6EB" />
