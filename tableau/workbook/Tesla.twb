                <format attr="color" value="#247B94" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[textscan.revenue].[sum:amount:qk]</rows>
        <cols>[textscan.revenue].[none:category:nk]</cols>
      </table>
    </worksheet>
