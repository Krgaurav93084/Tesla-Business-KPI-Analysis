    <datasource caption="inventory" inline="true" name="textscan.inventory" version="18.1">
      <connection class="textscan" directory="Data" filename="inventory.csv" password="" server="">
        <relation name="inventory#csv" table="[inventory#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator=",">
            <column datatype="string" name="category" ordinal="0" />
