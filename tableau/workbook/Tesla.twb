<?xml version='1.0' encoding='utf-8'?>
<workbook original-version="18.1" version="18.1" source-platform="mac" xmlns:user="http://www.tableausoftware.com/xml/user">
  <style-theme name="clean" />
  <datasources>
    <datasource caption="kpi" inline="true" name="textscan.kpi" version="18.1">
      <connection class="textscan" directory="Data" filename="kpi.csv" password="" server="">
        <relation name="kpi#csv" table="[kpi#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator=",">
            <column datatype="integer" name="revenue" ordinal="0" />
            <column datatype="real" name="margin" ordinal="1" />
            <column datatype="integer" name="deliveries" ordinal="2" />
            <column datatype="integer" name="energy" ordinal="3" />
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class="column">
            <remote-name>revenue</remote-name>
            <remote-type>20</remote-type>
            <local-name>[revenue]</local-name>
            <parent-name>[kpi#csv]</parent-name>
            <remote-alias>revenue</remote-alias>
            <ordinal>0</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>margin</remote-name>
            <remote-type>5</remote-type>
            <local-name>[margin]</local-name>
            <parent-name>[kpi#csv]</parent-name>
            <remote-alias>margin</remote-alias>
            <ordinal>1</ordinal>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>deliveries</remote-name>
            <remote-type>20</remote-type>
            <local-name>[deliveries]</local-name>
            <parent-name>[kpi#csv]</parent-name>
            <remote-alias>deliveries</remote-alias>
            <ordinal>2</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>energy</remote-name>
            <remote-type>20</remote-type>
            <local-name>[energy]</local-name>
            <parent-name>[kpi#csv]</parent-name>
            <remote-alias>energy</remote-alias>
            <ordinal>3</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled="yes" />
      <column caption="2025 revenue (USD million)" datatype="integer" name="[revenue]" role="measure" type="quantitative" />
      <column caption="2025 operating margin (%)" datatype="real" name="[margin]" role="measure" type="quantitative" />
      <column caption="2025 deliveries" datatype="integer" name="[deliveries]" role="measure" type="quantitative" />
      <column caption="2025 energy revenue (USD million)" datatype="integer" name="[energy]" role="measure" type="quantitative" />
    </datasource>
    <datasource caption="revenue" inline="true" name="textscan.revenue" version="18.1">
      <connection class="textscan" directory="Data" filename="revenue.csv" password="" server="">
        <relation name="revenue#csv" table="[revenue#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator=",">
            <column datatype="string" name="category" ordinal="0" />
            <column datatype="real" name="amount" ordinal="1" />
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class="column">
            <remote-name>category</remote-name>
            <remote-type>129</remote-type>
            <local-name>[category]</local-name>
            <parent-name>[revenue#csv]</parent-name>
            <remote-alias>category</remote-alias>
            <ordinal>0</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>amount</remote-name>
            <remote-type>5</remote-type>
            <local-name>[amount]</local-name>
            <parent-name>[revenue#csv]</parent-name>
            <remote-alias>amount</remote-alias>
            <ordinal>1</ordinal>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled="yes" />
      <column caption="Quarter" datatype="string" name="[category]" role="dimension" type="nominal" />
      <column caption="Revenue (USD million)" datatype="real" name="[amount]" role="measure" type="quantitative" />
    </datasource>
